# sdkconfig.defaults — Inversor Solar DT4862-BF Monitor — ESP32-S3
# Sin Bluetooth (solo WiFi + UART RS232)

# ---- Target ----
CONFIG_IDF_TARGET="esp32s3"

# ---- PSRAM ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SIZE=4194304
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=n

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- Bluetooth: DESACTIVADO ----
CONFIG_BT_ENABLED=n

# ---- WiFi ----
CONFIG_ESP_WIFI_ENABLED=y

# ---- HTTP Server: WebSocket support ----
CONFIG_HTTPD_WS_SUPPORT=y

# ---- LWIP: más sockets para HTTP + WebSockets ----
CONFIG_LWIP_MAX_SOCKETS=16

# ---- Tabla de particiones personalizada ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
